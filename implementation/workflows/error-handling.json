{
  "name": "PRJ-0001 - Error Handling (shared)",
  "nodes": [
    {
      "parameters": {
        "notice": "Shared sub-workflow, wired to every W1 stage. Covers exactly the named failure modes from Blueprint SS7: unreadable PDF, duplicate application, extraction failure, plus LLM call/parse failure.\n\nD03 REMEDIATION (2026-08-03, D03-DEF-004): early-pipeline failures (unreadable_pdf, extraction_failure, llm_parse_failure) occur BEFORE Duplicate Detection & Recording ever writes the Sheets row - a plain 'update' would find nothing to update. Changed to 'appendOrUpdate' keyed on record_id, which creates the row for an early failure and updates it for a late one (duplicate_application, which fires after the row exists)."
      },
      "name": "Blueprint Traceability",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "id": "error-handling-blueprint-traceability"
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "record_id"
            },
            {
              "name": "failure_mode"
            }
          ]
        }
      },
      "name": "Sub-workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "error-handling-sub-workflow-trigger"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.failure_mode}}",
                    "rightValue": "unreadable_pdf"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.failure_mode}}",
                    "rightValue": "duplicate_application"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.failure_mode}}",
                    "rightValue": "extraction_failure"
                  }
                ]
              }
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{$json.failure_mode}}",
                    "rightValue": "llm_parse_failure"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Route by Failure Mode",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        220,
        0
      ],
      "id": "error-handling-route-by-failure-mode"
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "sheetName": "Applicant Records",
        "matchingColumns": [
          "record_id"
        ],
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "record_id": "={{$json.record_id}}",
            "error_detail": "={{$json.failure_mode}}"
          }
        }
      },
      "name": "Record error_detail",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        440,
        0
      ],
      "id": "error-handling-record-error-detail"
    }
  ],
  "connections": {
    "Sub-workflow Trigger": {
      "main": [
        [
          {
            "node": "Route by Failure Mode",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Failure Mode": {
      "main": [
        [
          {
            "node": "Record error_detail",
            "type": "main",
            "index": 0
          }
        ],
