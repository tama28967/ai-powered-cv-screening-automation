    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "unreadable_pdf", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "duplicate_application", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "extraction_failure", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "llm_parse_failure", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "invalid_job_selection", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } },
            { "conditions": { "conditions": [{ "leftValue": "={{$json.failure_mode}}", "rightValue": "file_too_large", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and", "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 1 } } }
