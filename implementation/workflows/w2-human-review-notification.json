{
  "name": "PRJ-0001 - W2 - Human Review Gate & Notification",
  "nodes": [
    {
      "parameters": {
        "notice": "Independently-triggered workflow (Blueprint SS3 architecture decision): decouples 'record written' from 'candidate notified'. Fires only when review_status transitions to 'reviewed' - never directly from W1."
      },
      "name": "Blueprint Traceability",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -200
      ],
      "id": "w2-human-review-notification-blueprint-traceability"
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Applicant Records"
        },
        "triggerOn": "rowUpdate",
        "columnToWatch": "review_status",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1eiVPbSbJrZSiNa3FaKXgwQCJtxuew5zDeW7Qujgdd_8"
        }
      },
      "name": "Review Status Changed to Reviewed",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "w2-human-review-notification-review-status-changed-to-reviewed",
      "notes": "TEST BINDING (D08): documentId points at the Founder-Designated TEST spreadsheet 'PRJ-0001 Test - Applicant Records'. This is an environment binding, NOT a client/Production value - rebind before any Production deployment. See deployment/test-environment-designation.md."
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.review_status}}",
              "operator": {
                "operation": "equals"
              },
              "rightValue": "reviewed"
            }
          ]
        }
      },
      "name": "Is Reviewed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "w2-human-review-notification-is-reviewed"
    },
    {
      "parameters": {
        "sendTo": "={{$json.applicant_email}}",
        "subject": "Application Update",
        "message": "Candidate notification content - final copy is a Client Deliverable (D05), not authored here."
      },
      "name": "Send Candidate Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "w2-human-review-notification-send-candidate-notification"
    },
    {
      "parameters": {
        "operation": "update",
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Applicant Records"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "notification_sent": true
          }
        },
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "1eiVPbSbJrZSiNa3FaKXgwQCJtxuew5zDeW7Qujgdd_8"
        },
        "resource": "sheet"
      },
      "name": "Set notification_sent = true",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        660,
        0
      ],
      "id": "w2-human-review-notification-set-notification-sent-true",
      "notes": "TEST BINDING (D08): documentId points at the Founder-Designated TEST spreadsheet 'PRJ-0001 Test - Applicant Records'. This is an environment binding, NOT a client/Production value - rebind before any Production deployment. See deployment/test-environment-designation.md."
    }
  ],
  "connections": {
    "Review Status Changed to Reviewed": {
      "main": [
        [
          {
            "node": "Is Reviewed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Reviewed?": {
      "main": [
        [
          {
            "node": "Send Candidate Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Candidate Notification": {
      "main": [
        [
          {
            "node": "Set notification_sent = true",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
